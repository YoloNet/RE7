<?xml version="1.0" encoding="utf-8"?>
<!--
  StatusHD v1.0.0 — AndroidManifest.
  Kebenaran: media (pilih video/foto), notifikasi (progress mampatan),
  foreground service (mampatan latar). TIADA INTERNET — aplikasi ini
  100% atas peranti dalam fasa 1 (tiada iklan, tiada analitik, tiada server).
  TIADA lokasi, TIADA kenalan, TIADA kamera/mikrofon.
  Deep link / akaun: tiada — tiada pendaftaran.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pilih media dari galeri (Android 13+). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 12 ke bawah: storan lama. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Simpan ke galeri pada Android 9 ke bawah. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Notifikasi progress mampatan (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Servis mampatan latar. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <application
        android:name=".StatusHdApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StatusHD">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Servis mampatan latar (foreground, jenis media processing). -->
        <service
            android:name=".media.CompressService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />

        <!-- Kongsi fail output ke WhatsApp (URI content://, kebenaran sementara). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

    </application>

</manifest>
