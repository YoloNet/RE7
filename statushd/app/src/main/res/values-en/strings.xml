    <!-- S14 Support -->
    <string name="support_title">Help</string>
    <string name="support_email">Email support</string>
    <string name="support_faq1_q">Why is my video still blurry on Status?</string>
    <string name="support_faq1_a">WhatsApp re-compresses every video it receives. StatusHD compresses your video first at a suitable bitrate, so WhatsApp does not have to crush it again.</string>
    <string name="support_faq2_q">Are my videos sent to a server?</string>
    <string name="support_faq2_a">No. All compression happens on your phone. A video only leaves your phone when you share or save it yourself.</string>
    <string name="support_faq3_q">How long does compression take?</string>
    <string name="support_faq3_a">It depends on the length and quality of the video. A 30-second video is usually done in under a minute.</string>
    <string name="support_faq4_q">What is the output format?</string>
    <string name="support_faq4_a">MP4 (H.264 + AAC), 720p, 1080p or 4K as you choose, in the original aspect ratio or 9:16.</string>

