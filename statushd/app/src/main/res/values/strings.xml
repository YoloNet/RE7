    <!-- S14 Bantuan -->
    <string name="support_title">Bantuan</string>
    <string name="support_email">E-mel sokongan</string>
    <string name="support_faq1_q">Kenapa video saya masih kabur di Status?</string>
    <string name="support_faq1_a">WhatsApp memampatkan semula setiap video yang dihantar. StatusHD memampatkan video anda dahulu pada bitrate yang sesuai supaya WhatsApp tidak perlu memampatkannya lagi dengan teruk.</string>
    <string name="support_faq2_q">Adakah video saya dihantar ke server?</string>
    <string name="support_faq2_a">Tidak. Semua mampatan dibuat dalam telefon anda. Video hanya keluar dari telefon apabila anda sendiri berkongsi atau menyimpannya.</string>
    <string name="support_faq3_q">Berapa lama mampatan mengambil masa?</string>
    <string name="support_faq3_a">Bergantung pada panjang dan kualiti video. Video 30 saat biasanya siap dalam masa kurang seminit.</string>
    <string name="support_faq4_q">Apakah format output?</string>
    <string name="support_faq4_a">MP4 (H.264 + AAC), 720p, 1080p atau 4K mengikut pilihan anda, dengan nisbah asal atau 9:16.</string>

